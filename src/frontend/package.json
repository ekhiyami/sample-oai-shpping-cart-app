{
  "name": "ai-shopping-cart-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@babel/runtime": "^7.26.10",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.34",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "scripts": {
    "envconfig": "node entrypoint.js -e .env -o ./public/env-config.js",
    "prestart": "npm run envconfig",
    "start": "vite --host 127.0.0.1 --port 3000",
    "prebuild": "npm run envconfig",
    "build": "tsc --noEmit && vite build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25"
  }
}
